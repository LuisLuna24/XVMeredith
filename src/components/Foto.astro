<section
    class="px-4 md:px-6 lg:px-8 py-10 md:py-14 lg:py-16"
    data-reveal
    aria-label="Recuerdo de Valeria"
>
    <div class="relative max-w-sm md:max-w-md mx-auto mb-11">
        <!-- Capa de profundidad 1 - sombra proyectada -->
        <div
            class="absolute inset-x-0 top-4 bottom-0 translate-x-4 translate-y-4 rotate-[1.2deg] rounded-2xl bg-neutral-400/15 shadow-[0_28px_55px_-12px_rgba(0,0,0,0.18)] blur-md"
            aria-hidden="true"
        >
        </div>

        <!-- Capa de profundidad 2 - papel intermedio -->
        <div
            class="absolute inset-x-0 top-2 bottom-0 translate-x-2 translate-y-2 rotate-[-0.4deg] rounded-2xl bg-white/60 shadow-[0_14px_32px_-6px_rgba(0,0,0,0.10)]"
            aria-hidden="true"
        >
        </div>

        <!-- Polaroid principal -->
        <figure
            class="relative rotate-[-0.5deg] rounded-2xl bg-white p-5 md:p-6 lg:p-7 shadow-[0_28px_55px_-12px_rgba(0,0,0,0.22)] ring-1 ring-neutral-900/5 transition-all duration-500 hover:rotate-0 hover:shadow-[0_35px_70px_-15px_rgba(0,0,0,0.28)] hover:ring-neutral-900/10"
        >
            <!-- Foto -->
            <div class="relative overflow-hidden rounded-xl">
                <img
                    src="/img/foto.webp"
                    onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1530103862676-de8c9debad1d?w=800&q=70&auto=format&fit=crop'"
                    alt="Meredith Zavala de niña con vestido morado, recuerdo inolvidable"
                    width="800"
                    height="900"
                    loading="lazy"
                    class="block aspect-[4/5] w-full object-cover transition-transform duration-700 hover:scale-[1.015]"
                />
                <!-- Sutil overlay de brillo en hover -->
                <div
                    class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-neutral-900/10 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                    aria-hidden="true"
                >
                </div>
            </div>

            <!-- Texto de la polaroid -->
            <figcaption class="pt-6 text-center">
                <p
                    class="font-didone text-3xl md:text-4xl lg:text-5xl leading-[1.05] text-neutral-950 tracking-tight"
                >
                    Meredith
                    <span
                        class="ml-1 text-2xl md:text-3xl lg:text-4xl text-amber-500"
                        aria-hidden="true"
                    >
                        ✨
                    </span>
                </p>

                <p
                    class="mt-5 font-sans text-xs md:text-sm font-semibold leading-5 tracking-[0.22em] text-neutral-500 uppercase"
                >
                    RECUERDOS INOLVIDABLES
                </p>
            </figcaption>
        </figure>
    </div>
    <br />

    <!-- Frase y homenaje -->
    <div class="mx-auto mt-20 max-w-xl px-4 text-center" data-reveal>
        <blockquote class="relative">
            <!-- Decorative top accent -->
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16"
                aria-hidden="true"
            >
            </div>

            <p
                class="font-didone text-base md:text-lg lg:text-xl leading-[1.7] text-neutral-700 tracking-tight italic relative z-10 pb-8"
            >
                En honor a mis queridos familiares que ya no están con nosotros,
                <br />
                <span class="not-italic font-normal text-neutral-600"
                    >disfruten de este día tan especial</span
                >
            </p>

            <!-- Names list -->
            <div
                class="flex flex-col md:flex-row items-center justify-center gap-2 md:gap-3 mt-6 pt-6 border-t border-neutral-200 relative z-10"
                role="list"
                aria-label="Familiares recordados"
            >
                <span
                    class="font-didone text-sm md:text-base text-neutral-800 leading-relaxed px-3 py-1.5"
                    role="listitem"
                >
                    Sonia Garduño Caamaño
                </span>
                <span
                    class="w-px h-6 bg-neutral-300 md:hidden"
                    aria-hidden="true"></span>
                <span
                    class="w-px h-6 bg-neutral-300 hidden md:block"
                    aria-hidden="true"></span>
                <span
                    class="font-didone text-sm md:text-base text-neutral-800 leading-relaxed px-3 py-1.5"
                    role="listitem"
                >
                    José Alfredo Quintero Servín
                </span>
                <span
                    class="w-px h-6 bg-neutral-300 md:hidden"
                    aria-hidden="true"></span>
                <span
                    class="w-px h-6 bg-neutral-300 hidden md:block"
                    aria-hidden="true"></span>
                <span
                    class="font-didone text-sm md:text-base text-neutral-800 leading-relaxed px-3 py-1.5"
                    role="listitem"
                >
                    Gregoria Zamora
                </span>
            </div>
        </blockquote>
    </div>
</section>
