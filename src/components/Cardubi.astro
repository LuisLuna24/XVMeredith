---
interface Props {
    title: string;
    time: string;
    map?: string;
    type: string;
    typeIcon: string;
    color: string;
    address: string;
}

const { title, time, map, type, typeIcon, color, address } = Astro.props;
---

<style>
    .card {
        background: linear-gradient(145deg, #f5f5f5 0%, #eaeaea 100%);
        border: 1px solid #d0d0d0;
        border-radius: 20px;
        padding: 28px 24px;
        position: relative;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow:
            0 4px 24px rgba(0, 0, 0, 0.08),
            0 1px 3px rgba(0, 0, 0, 0.05),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #c9b896 50%, transparent);
        opacity: 0.8;
    }

    .card::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #a00000, transparent);
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .card:hover {
        border-color: #c9b896;
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.12),
            0 2px 8px rgba(0, 0, 0, 0.08),
            inset 0 1px 0 rgba(255, 255, 255, 0.9),
            0 0 0 1px rgba(201, 184, 150, 0.3);
        transform: translateY(-2px);
    }

    .card:hover::after {
        opacity: 1;
    }

    .meta-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #6b5b3a;
        margin-bottom: 10px;
    }

    .meta-icon {
        font-size: 14px;
        line-height: 1;
        color: #a00000;
    }

    .title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 22px;
        font-weight: 500;
        line-height: 1.2;
        color: #1a1a1a;
        letter-spacing: -0.02em;
        margin: 0 0 8px;
    }

    .address {
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 13px;
        font-weight: 400;
        line-height: 1.4;
        color: #5a5a5a;
        margin: 0 0 16px;
    }

    .map-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        height: 48px;
        padding: 0 24px;
        border-radius: 12px;
        border: 1px solid #d0d0d0;
        background: #ffffff;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: #3a3a3a;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        min-width: 160px;
    }

    .map-btn:hover,
    .map-btn:active {
        border-color: #a00000;
        background: #a00000;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(160, 0, 0, 0.25);
    }

    .map-btn:active {
        transform: scale(0.98);
    }

    .map-btn svg {
        stroke: currentColor;
        flex-shrink: 0;
    }

    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 6px;
        background: rgba(160, 0, 0, 0.1);
        border: 1px solid rgba(160, 0, 0, 0.2);
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #a00000;
        margin-bottom: 12px;
    }
</style>

<article class="card">
    <div class="type-badge">
        <span class="meta-icon" aria-hidden="true">{typeIcon}</span>
        <span>{type}</span>
    </div>

    <h3 class="title">{title}</h3>

    <p class="address">{address}</p>

    {
        map && (
            <a href={map} target="_blank" rel="noopener" class="map-btn">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke-width="2.2"
                    class="h-[14px] w-[14px]"
                    aria-hidden="true"
                >
                    <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z" />
                    <circle cx="12" cy="10" r="2.5" />
                </svg>
                <span>Ver mapa</span>
            </a>
        )
    }
</article>
