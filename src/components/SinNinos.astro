---
interface Props {
    message?: string;
}
const {
    message = "Será una celebración exclusiva para adultos, disfrutemos de una noche sin pequeños.",
} = Astro.props;
---

<style>
    .sin-ninos {
        padding: 4rem 1.5rem;
        text-align: center;
        position: relative;
    }

    .sin-ninos::before {
        content: "";
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #c9b896, transparent);
        opacity: 0.6;
    }

    .sin-ninos::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #c9b896, transparent);
        opacity: 0.6;
    }

    .icon-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 88px;
        height: 88px;
        margin-bottom: 1.75rem;
        border-radius: 50%;
        background: linear-gradient(145deg, #fafafa 0%, #f0f0f0 100%);
        border: 1px solid #e8e0d8;
        box-shadow:
            0 4px 24px rgba(0, 0, 0, 0.05),
            inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }

    .icon-wrapper::before {
        content: "";
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 1px solid transparent;
        background: linear-gradient(
            145deg,
            rgba(201, 184, 150, 0.3),
            transparent 70%
        );
        -webkit-mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        mask:
            linear-gradient(#fff 0 0) content-box,
            linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
    }

    .icon-svg {
        width: 44px;
        height: 44px;
        color: #8a7a6a;
        stroke-width: 1.8;
    }

    .sin-ninos-title {
        font-family: "Playfair Display", Georgia, serif;
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        font-weight: 500;
        line-height: 1.2;
        color: #1a1a1a;
        letter-spacing: -0.02em;
        margin: 0 0 1rem;
    }

    .sin-ninos-text {
        font-family: "Bodoni Moda", "Playfair Display", Georgia, serif;
        font-size: 1.125rem;
        font-weight: 400;
        line-height: 1.6;
        color: #4a4a4a;
        letter-spacing: 0.005em;
        max-width: 42ch;
        margin: 0 auto 1.5rem;
    }

    .sin-ninos-detail {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        color: #a00000;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .sin-ninos-detail::before,
    .sin-ninos-detail::after {
        content: "";
        width: 24px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #c9b896, transparent);
        opacity: 0.6;
    }

    @media (prefers-reduced-motion: reduce) {
        .icon-wrapper {
            animation: none !important;
        }
    }
</style>

<section class="sin-ninos" data-reveal aria-label="Información: evento solo para adultos">
    <div class="icon-wrapper" aria-hidden="true">
        <svg
            class="icon-svg"
            viewBox="0 0 48 48"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            role="img"
            aria-label="Icono indicando evento sin niños"
        >
            <!-- Círculo exterior y línea diagonal de prohibición -->
            <circle cx="24" cy="24" r="21"></circle>
            <line x1="9" y1="39" x2="39" y2="9"></line>

            <!-- Silueta del adulto (más estilizada y centrada) -->
            <circle cx="21" cy="16" r="3.5"></circle>
            <path d="M21 21v10c0 1.1.9 2 2 2h1"></path>
            <path d="M15 25l6-4 3 2"></path>

            <!-- Silueta del niño (más pequeña y tachada sutilmente) -->
            <circle cx="31" cy="30" r="2.5"></circle>
            <path d="M31 33v6"></path>
            <path d="M27 36l4-2 4 2"></path>
        </svg>
    </div>

    <h3 class="sin-ninos-title">Celebración Solo para Adultos</h3>

    <p class="sin-ninos-text">{message}</p>

    <p class="sin-ninos-detail">Agradecemos su comprensión</p>
</section>
