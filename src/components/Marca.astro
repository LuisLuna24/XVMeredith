---

---

<a
    href="https://lunaweb.com.mx"
    target="_blank"
    rel="noopener noreferrer"
    class="marca-watermark"
    aria-label="Desarrollado por LunaWeb - Ver portafolio"
>
    <svg
        class="marca-logo"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
        width="24"
        height="24"
    >
        <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="1.5"
        ></circle>
        <path
            d="M10 16L14 20L22 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
    </svg>
    <span class="marca-text">Pagina de muestra · LunaWeb</span>
</a>

<style>
    .marca-watermark {
        position: fixed;
        bottom: 1rem;
        left: 1rem;
        z-index: 1000;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 9999px;
        color: #1a1a1a;
        text-decoration: none;
        font-family: "Montserrat", system-ui, sans-serif;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        opacity: 0.7;
        transition:
            opacity 0.2s ease,
            transform 0.2s ease,
            background 0.2s ease,
            border-color 0.2s ease;
        white-space: nowrap;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    .marca-watermark:hover,
    .marca-watermark:focus-visible {
        opacity: 1;
        transform: translateY(-2px);
        background: rgba(255, 255, 255, 1);
        border-color: rgba(0, 0, 0, 0.2);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        outline: none;
    }

    .marca-watermark:focus-visible {
        outline: 2px solid #1a1a1a;
        outline-offset: 2px;
    }

    .marca-logo {
        flex-shrink: 0;
        color: #1a1a1a;
        transition: color 0.2s ease;
    }

    .marca-watermark:hover .marca-logo,
    .marca-watermark:focus-visible .marca-logo {
        color: #000;
    }

    @media (prefers-color-scheme: dark) {
        .marca-watermark {
            background: rgba(17, 17, 17, 0.9);
            border-color: rgba(255, 255, 255, 0.1);
            color: #f5f5f5;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .marca-watermark:hover,
        .marca-watermark:focus-visible {
            background: rgba(17, 17, 17, 1);
            border-color: rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        }

        .marca-watermark:focus-visible {
            outline-color: #f5f5f5;
        }

        .marca-logo {
            color: #f5f5f5;
        }

        .marca-watermark:hover .marca-logo,
        .marca-watermark:focus-visible .marca-logo {
            color: #fff;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marca-watermark {
            transition: none;
        }
    }

    @media (max-width: 480px) {
        .marca-watermark {
            bottom: 0.75rem;
            right: 0.75rem;
            left: 0.75rem;
            justify-content: center;
            padding: 0.5rem;
            border-radius: 0.5rem;
        }

        .marca-text {
            font-size: 0.65rem;
        }
    }
</style>
