---
interface Props {
    targetDate?: string;
    label?: string;
}

const {
    targetDate = "2026-11-20T20:00:00",
    label = "FALTAN PARA LA GRAN NOCHE",
} = Astro.props;
---

<style>
    .countdown-section {
        padding: 2.5rem 1.25rem;
    }

    .countdown-card {
        background: linear-gradient(145deg, #fafafa 0%, #f0f0f0 100%);
        border: 1px solid #e0e0e0;
        border-radius: 24px;
        padding: 2rem 1.5rem;
        position: relative;
        overflow: hidden;
        box-shadow:
            0 4px 24px rgba(0, 0, 0, 0.06),
            0 1px 3px rgba(0, 0, 0, 0.04),
            inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }

    .countdown-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
            90deg,
            transparent,
            #c9b896 50%,
            transparent
        );
        opacity: 0.8;
    }

    .countdown-label {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.28em;
        color: #8a7a6a;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .countdown-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
    }

    @media (max-width: 480px) {
        .countdown-grid {
            gap: 0.5rem;
        }
    }

    .countdown-unit {
        background: #ffffff;
        border: 1px solid #e8e8e8;
        border-radius: 16px;
        padding: 1.5rem 1rem;
        position: relative;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow:
            0 2px 8px rgba(0, 0, 0, 0.04),
            inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    .countdown-unit::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #c9b896, transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .countdown-unit:hover,
    .countdown-unit:focus-within {
        border-color: #c9b896;
        box-shadow:
            0 4px 16px rgba(0, 0, 0, 0.08),
            0 1px 4px rgba(0, 0, 0, 0.05),
            inset 0 1px 0 rgba(255, 255, 255, 0.95),
            0 0 0 1px rgba(201, 184, 150, 0.2);
        transform: translateY(-1px);
    }

    .countdown-unit:hover::before,
    .countdown-unit:focus-within::before {
        opacity: 1;
    }

    .countdown-unit--highlight {
        border-color: #f0e0d0;
        background: linear-gradient(180deg, #fffdf8 0%, #fff8f0 100%);
    }

    .countdown-unit--highlight:hover,
    .countdown-unit--highlight:focus-within {
        border-color: #a00000;
        box-shadow:
            0 4px 16px rgba(160, 0, 0, 0.1),
            0 1px 4px rgba(0, 0, 0, 0.05),
            inset 0 1px 0 rgba(255, 255, 255, 0.95),
            0 0 0 1px rgba(160, 0, 0, 0.15);
    }

    .countdown-value {
        font-family: "Playfair Display", Georgia, serif;
        font-size: clamp(2.5rem, 8vw, 4rem);
        font-weight: 500;
        line-height: 1;
        color: #1a1a1a;
        letter-spacing: -0.03em;
        margin: 0 0 0.5rem;
        font-variant-numeric: tabular-nums;
    }

    .countdown-unit--highlight .countdown-value {
        color: #a00000;
    }

    .countdown-unit-label {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #8a7a6a;
        margin: 0;
    }

    .countdown-separator {
        display: none;
    }

    @media (max-width: 640px) {
        .countdown-value {
            font-size: clamp(2rem, 6vw, 3rem);
        }

        .countdown-unit {
            padding: 1.25rem 0.75rem;
        }
    }
</style>

<section
    class="countdown-section"
    data-reveal
    data-target={targetDate}
    aria-label="Cuenta regresiva"
>
    <article class="countdown-card">
        <p class="countdown-label">{label}</p>

        <div
            class="countdown-grid"
            role="timer"
            aria-live="off"
            aria-label="Tiempo restante para el evento"
        >
            <div class="countdown-unit countdown-unit--highlight" tabindex="0">
                <p class="countdown-value" id="dias">00</p>
                <p class="countdown-unit-label">DÍAS</p>
            </div>

            <div class="countdown-unit" tabindex="0">
                <p class="countdown-value" id="horas">00</p>
                <p class="countdown-unit-label">HRS</p>
            </div>

            <div class="countdown-unit" tabindex="0">
                <p class="countdown-value" id="minutos">00</p>
                <p class="countdown-unit-label">MIN</p>
            </div>

            <div class="countdown-unit countdown-unit--highlight" tabindex="0">
                <p class="countdown-value" id="segundos">00</p>
                <p class="countdown-unit-label">SEG</p>
            </div>
        </div>
    </article>
</section>

<script is:inline>
    (function () {
        function init() {
            const section = document.querySelector(".countdown-section");
            if (!section) return;

            const target = new Date(section.dataset.target).getTime();

            const diasEl = document.getElementById("dias");
            const horasEl = document.getElementById("horas");
            const minutosEl = document.getElementById("minutos");
            const segundosEl = document.getElementById("segundos");

            function pad(n) {
                return String(n).padStart(2, "0");
            }

            function updateCountdown() {
                const diff = target - Date.now();

                if (isNaN(diff) || diff <= 0) {
                    [diasEl, horasEl, minutosEl, segundosEl].forEach((el) => {
                        if (el) el.textContent = "00";
                    });
                    return;
                }

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor(
                    (diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
                );
                const minutes = Math.floor(
                    (diff % (1000 * 60 * 60)) / (1000 * 60),
                );
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);

                if (diasEl) diasEl.textContent = pad(days);
                if (horasEl) horasEl.textContent = pad(hours);
                if (minutosEl) minutosEl.textContent = pad(minutes);
                if (segundosEl) segundosEl.textContent = pad(seconds);
            }

            updateCountdown();
            setInterval(updateCountdown, 1000);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init);
        } else {
            init();
        }
    })();
</script>
