---
const name = Astro.props.name;
---

<div
    class="fixed inset-0 z-[100] flex items-center justify-center overflow-hidden bg-[#2b0a12] px-6"
    role="dialog"
    aria-modal="true"
    aria-label="Bienvenida a la invitación de Meredith Zavala"
    id="entry-overlay"
>
    <!-- Fondo ambiental -->
    <div class="absolute inset-0" aria-hidden="true">
        <img
            src="/img/foto.webp"
            alt=""
            class="h-full w-full object-cover opacity-30 blur-[2px] scale-105"
            loading="eager"
        />
        <div
            class="absolute inset-0 bg-gradient-to-b from-[#2b0a12]/70 via-[#6d0a1c]/75 to-[#2b0a12]/90"
        >
        </div>
        <div
            class="absolute inset-0 opacity-[0.12] [background-image:radial-gradient(white_1px,transparent_1px)] [background-size:22px_22px]"
        >
        </div>
    </div>

    <div class="relative w-full max-w-sm text-center" id="entry-card">
        <!-- Imagen encima del botón -->
        <div class="mx-auto mb-6 w-fit" data-entry>
            <div class="relative">
                <div
                    class="absolute -inset-3 rounded-full border border-white/25"
                    aria-hidden="true"
                >
                </div>
                <div
                    class="absolute -inset-6 rounded-full border border-white/10"
                    aria-hidden="true"
                >
                </div>
                <img
                    src="/img/foto.webp"
                    onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1530103862676-de8c9debad1d?w=600&q=70&auto=format&fit=crop'"
                    alt="Fotografía de Valeria"
                    width="400"
                    height="400"
                    class="h-44 w-44 rounded-full object-cover ring-4 ring-white/80 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.7)] aspect-square"
                />
                <span
                    class="absolute -bottom-2 left-1/2 -translate-x-1/2 rounded-full bg-[#7f1022] px-4 py-1 font-didone text-xs tracking-[0.25em] text-white shadow-lg ring-1 ring-white/40"
                    >MIS XV</span
                >
            </div>
        </div>

        <p class="text-bodoni text-3xl text-[#f6e8ea]" data-entry>
            Te invito a festejar
        </p>
        <h1
            class="font-didone mt-4 text-5xl font-bold leading-[1.05] tracking-wide text-white"
            data-entry
        >
            {name}
        </h1>
        <p
            class="mt-5 text-[11px] font-semibold tracking-[0.35em] text-[#e9c8cd]"
            data-entry
        >
            — GALA DE QUINCEAÑERA —
        </p>
        <p
            class="mt-5 text-sm tracking-[0.2em] text-white/80 font-didone"
            data-entry
        >
            VIERNES · 20 NOVIEMBRE 2026
        </p>

        <div data-entry>
            <button
                type="button"
                @click="entrar()"
                class="btn-wine group mx-auto mt-10 flex min-h-[52px] min-w-[240px] cursor-pointer items-center justify-center gap-3 rounded-full px-8 text-sm font-bold tracking-[0.2em] text-white shadow-lg"
                aria-label="Entrar a la invitación y reproducir música"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    class="h-5 w-5 transition-transform duration-300 group-hover:scale-110"
                    aria-hidden="true"
                >
                    <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
                    <path d="m3.5 7 8.5 6 8.5-6"></path>
                </svg>
                ABRIR INVITACIÓN
            </button>
        </div>
        <p
            class="mt-6 flex items-center justify-center gap-2 text-xs text-white/70"
            data-entry
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                class="h-4 w-4"
                aria-hidden="true"
                ><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"
                ></circle><circle cx="18" cy="16" r="3"></circle></svg
            >
            Al entrar se reproducirá la música
        </p>
        <p x-show="audioError" x-cloak class="mt-3 text-xs text-amber-200">
            Agrega tu canción en <code>public/musica.mp3</code> para escucharla aquí.
        </p>
    </div>
</div>
