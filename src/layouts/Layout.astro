---
import "../styles/global.css";
import Marca from "../components/Marca.astro";
interface Props {
  title?: string;
}
const { title = "Meredith Zavala · Gala de Quinceañera" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="Te invito a festejar mis 15 años — Meredith Zavala, Gala de Quinceañera. Viernes 20 de Noviembre, 20:00 hrs."
    />
    <meta
      name="theme-color"
      content="#6d0a1c"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#2b0a12"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Herr+Von+Muellerhoff&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#invitacion"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:bg-white focus:px-4 focus:py-2 focus:rounded-full focus:text-sm"
      >Saltar a la invitación</a
    >
    <slot />
    <Marca />
  </body>
</html>
